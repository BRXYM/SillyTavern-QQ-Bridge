{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "noEmit": true,
        "composite": false,
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "allowImportingTsExtensions": true,
        "rewriteRelativeImportExtensions": true,
        "types": [
            "node"
        ]
    },
    "include": [
        "src/**/*.ts",
        "tests/**/*.ts"
    ]
}
