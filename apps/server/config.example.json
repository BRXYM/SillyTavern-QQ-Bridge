{
    "onebotUrl": "ws://127.0.0.1:3001",
    "onebotToken": "<YOUR_ONEBOT_TOKEN>",
    "stExtPort": 9500,
    "consolePort": 9510,
    "trigger": {
        "atOnly": false,
        "privateReply": true,
        "allowedUsers": [],
        "allowedGroups": []
    },
    "maxMessageLength": 2000,
    "replyProcessors": [],
    "defaults": {
        "character": "雪乃",
        "world": "雪之镇设定"
    },
    "backend": "taver",
    "dshExePath": "",
    "dshProfile": "headless",
    "dshWorkRoot": "",
    "dshTimeoutMs": 180000,
    "dshHistoryTurns": 6,
    "dshSystemPrompt": "",
    "dshErrorReply": "",
    "dshPersistHistory": true,
    "dshConcurrency": 1,
    "stDataDir": "",
    "segmentation": {
        "enabled": true,
        "maxLen": 200,
        "minLen": 6,
        "maxSegments": 12,
        "hardChars": "。！？!?…",
        "softChars": "，,；;",
        "pairChars": [
            [
                "动作",
                "*"
            ],
            [
                "台词",
                "\""
            ],
            [
                "中文台词",
                "“”"
            ],
            [
                "括号动作",
                "（）"
            ]
        ],
        "splitStrings": [],
        "splitOnPairs": true,
        "delayMs": [
            300,
            900
        ]
    },
    "imageReplies": {
        "enabled": true,
        "instruction": true,
        "baseUrl": ""
    }
}
