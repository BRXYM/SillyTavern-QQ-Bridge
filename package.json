{
    "name": "snowluma-st-bridge",
    "version": "3.0.0",
    "private": true,
    "type": "module",
    "description": "Multi-account QQ and multi-downstream control console",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "dev": "node scripts/dev.mjs",
        "dev:web": "node scripts/dev.mjs --web-only",
        "dev:api": "node scripts/dev.mjs --api-only",
        "build": "pnpm --filter @bridge/web build",
        "start": "pnpm --filter @bridge/server start",
        "test": "pnpm -r test",
        "typecheck": "pnpm --filter @bridge/server typecheck && pnpm --filter @bridge/web typecheck"
    },
    "devDependencies": {
        "typescript": "~5.9.3"
    },
    "packageManager": "pnpm@11.25.0"
}
